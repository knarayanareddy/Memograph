# ─────────────────────────────────────────────────────────────
# Memograph configuration. Copy to .env and keep it out of Git.
# All secret values are intentionally empty.
# ─────────────────────────────────────────────────────────────

# Core
MEMOGRAPH_BASE_PATH=.memograph
MEMOGRAPH_AGENT_ID=default
MEMOGRAPH_LLM_PROVIDER=ollama
MEMOGRAPH_AUTO_CONSOLIDATE=false
MEMOGRAPH_SKEPTICAL_MODE=true
MEMOGRAPH_DEBUG_PROMPTS=false
# MEMOGRAPH_CONTEXT_WINDOW_TOKENS=8192

# REST API (required by memograph-api; never commit a real key)
MEMOGRAPH_API_KEY=
MEMOGRAPH_API_HOST=0.0.0.0
MEMOGRAPH_API_PORT=8000
MEMOGRAPH_API_RATE_LIMIT_PER_MINUTE=60
MEMOGRAPH_API_CORS_ORIGINS=
MEMOGRAPH_API_LOG_LEVEL=info

# Consolidation provider (optional; falls back to MEMOGRAPH_LLM_PROVIDER)
# MEMOGRAPH_CONSOLIDATION_PROVIDER=ollama
# MEMOGRAPH_CONSOLIDATION_MODEL=llama3.1:8b

# Ollama (local; no key)
MEMOGRAPH_OLLAMA_MODEL=llama3.1:8b
MEMOGRAPH_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI / compatible endpoints
OPENAI_API_KEY=
MEMOGRAPH_OPENAI_MODEL=gpt-4o-mini
MEMOGRAPH_OPENAI_BASE_URL=https://api.openai.com/v1

# Groq
GROQ_API_KEY=
MEMOGRAPH_GROQ_MODEL=llama-3.1-8b-instant
MEMOGRAPH_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic
ANTHROPIC_API_KEY=
MEMOGRAPH_ANTHROPIC_MODEL=claude-3-5-haiku-latest
MEMOGRAPH_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini
GOOGLE_API_KEY=
MEMOGRAPH_GEMINI_MODEL=gemini-1.5-flash

# Custom OpenAI-compatible endpoint (LM Studio, vLLM, LocalAI, ...)
CUSTOM_API_KEY=
MEMOGRAPH_CUSTOM_API_KEY=
MEMOGRAPH_CUSTOM_MODEL=
MEMOGRAPH_CUSTOM_BASE_URL=
